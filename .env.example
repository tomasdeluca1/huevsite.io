# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Lemon Squeezy (pagos)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_CHECKOUT_URL=
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=

# Feature flags
NEXT_PUBLIC_FF_SOCIAL=false

# Admin
ADMIN_SECRET=

# X (Twitter) API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# GitHub API (powers the GitHub block: stars, repos, followers, real
# contribution heatmap, per-month commits). App-level classic PAT — no scopes
# needed for public data. Create at https://github.com/settings/tokens
# Without it, the block falls back to unauthenticated REST (rate-limited).
GITHUB_TOKEN=

# Beehiiv newsletter sync (auto-subscribe new signups)
# https://app.beehiiv.com/settings/integrations/api
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
