# ─── Supabase (required) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site (required) ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin identity (required for /admin in production) ────────────────
# Comma-separated list of admin emails allowed into /admin.
ADMIN_EMAILS=
# Protected owner username (cannot be deleted through the admin panel).
ADMIN_USERNAME=
# Shared secret for admin/cron HTTP endpoints.
ADMIN_SECRET=
# Secret for Vercel cron auth (Bearer). Defaults to ADMIN_SECRET if your
# routes are written that way; set explicitly for cron jobs.
CRON_SECRET=

# ─── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
# Default "From" address for all outbound email. Falls back to the brand
# address if unset. Use a domain you control / have verified in Resend.
EMAIL_FROM=
# Recipient for internal notifications (feedback, interview events).
# If unset, those notifications are silently skipped.
NOTIFY_EMAIL=
# Secret used to sign one-click unsubscribe links. Falls back to ADMIN_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=

# ─── Payments (Lemon Squeezy) ──────────────────────────────────────────
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_CHECKOUT_URL=
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=
# Lifetime ("Founder") plan variant + checkout URL.
LEMON_LIFETIME_VARIANT_ID=
NEXT_PUBLIC_LEMON_LIFETIME_CHECKOUT_URL=

# ─── AI (optional — powers block generation, rewrite, onboarding AI) ───
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── GitHub API (powers the GitHub block: stars, repos, heatmap, commits)
# App-level classic PAT — no scopes needed for public data. Without it the
# block falls back to unauthenticated REST (rate-limited, no heatmap).
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── Social / content automation (optional) ────────────────────────────
NEXT_PUBLIC_FF_SOCIAL=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TYPEFULLY_API_KEY=
# Typefully social set with the LinkedIn company page connected — enables the
# LinkedIn auto-announcements (BDLS winner, community milestones, weekly digest).
TYPEFULLY_SOCIAL_SET_ID=
# Beehiiv newsletter sync (auto-subscribe new signups).
# https://app.beehiiv.com/settings/integrations/api
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ─── Custom domains via Vercel API (optional — /api/profile/verify-domain)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
